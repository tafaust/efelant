# Local trial. For a company deploy run ./scripts/new-secrets.sh instead.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=efelant_dev_postgres
POSTGRES_DB=efelant

EFELANT_MIGRATOR_PASSWORD=efelant_migrator_dev_password
EFELANT_APP_PASSWORD=efelant_app_dev_password

EFELANT_DB_HOST=localhost
EFELANT_DB_PORT=5432
EFELANT_DB_NAME=efelant
EFELANT_DB_USER=efelant_app
EFELANT_DB_PASSWORD=efelant_app_dev_password
# disable | require | verifyFull  (native Flutter clients)
EFELANT_DB_SSLMODE=disable
# disable | require               (web-gateway → postgres on the compose network)
EFELANT_GATEWAY_DB_SSLMODE=disable

# 1 = create alice/bob/charlie on first database init only
EFELANT_SEED=1

EFELANT_WEB_PORT=8080
EFELANT_WS_PORT=5433
EFELANT_REST_PORT=18080
EFELANT_GRPC_PORT=18081
# * allows any browser origin (local). Production must be the exact https origin.
EFELANT_WS_ORIGINS=*
EFELANT_WS_MAX_CONNECTIONS=80

# Used only with docker-compose.caddy.yml
# EFELANT_DOMAIN=chat.example.com
# EFELANT_WS_ORIGINS=https://chat.example.com
